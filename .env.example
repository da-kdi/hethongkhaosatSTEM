# Sao chép thành .env.local. KHÔNG commit file .env thật.
# Để trống VITE_SUPABASE_* → app chạy CHẾ ĐỘ DEMO (dữ liệu hư cấu, chạy trong trình duyệt).
VITE_APP_NAME="Quản trị STEM"
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Chỉ dùng cho test DB / script local (Postgres 15+ có quyền CREATE DATABASE)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
